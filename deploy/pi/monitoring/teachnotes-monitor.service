[Unit]
Description=TeachNotes Raspberry Pi health snapshot and heartbeats
After=network-online.target docker.service tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/teachnotes/monitor.env
ExecStart=/usr/local/sbin/teachnotes-monitor
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/log/teachnotes-monitor /var/lib/teachnotes-monitor
